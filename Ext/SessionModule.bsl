Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	ФИОПользователя = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИмяПользователя = СокрЛП(ФИОПользователя.Имя);
	ТекПользовательИзСправочника = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя);
	Если ТекПользовательИзСправочника.Ссылка <> Справочники.Пользователи.ПустаяСсылка() Тогда
		ПараметрыСеанса.ТекущийПользователь = ТекПользовательИзСправочника.Ссылка;
	Иначе
		Спр = Справочники.Пользователи.СоздатьЭлемент();
		Спр.Наименование = ИмяПользователя;
		Попытка
			Спр.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
