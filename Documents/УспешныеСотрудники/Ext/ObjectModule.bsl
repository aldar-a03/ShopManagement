
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОценкаРаботы") Тогда
		// Заполнение шапки
		Сотрудник = ДанныеЗаполнения.Сотрудник;
		ТекущаяДолжность = ДанныеЗаполнения.ТекущаяДолжность;
		Для Каждого ТекСтрокаПроверкаРезультатовРаботы Из ДанныеЗаполнения.ПроверкаРезультатовРаботы Цикл
			Если ТекСтрокаПроверкаРезультатовРаботы.Оценка = Перечисления.ОценкаРаботы.Удовлетворительно Тогда
				НоваяСтрока = ПроверкаРезультатовРаботы.Добавить();
				НоваяСтрока.Оценка = ТекСтрокаПроверкаРезультатовРаботы.Оценка;
				НоваяСтрока.Сотрудник = ТекСтрокаПроверкаРезультатовРаботы.Сотрудник;
				НоваяСтрока.ТекущаяДолжность = ТекСтрокаПроверкаРезультатовРаботы.ТекущаяДолжность;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры
